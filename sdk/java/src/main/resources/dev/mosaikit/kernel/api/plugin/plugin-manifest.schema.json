{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaikit.github.io/schemas/plugin-manifest/0.1.json",
  "title": "Mosaikit plugin manifest",
  "description": "Declares what a plugin is, what it needs and what it contributes. The kernel applies the same rules in PluginManifests (kernel-api).",
  "type": "object",
  "required": ["id", "version", "name", "kind", "platform"],
  "properties": {
    "id": {
      "description": "Stable reverse-DNS identifier.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "version": {
      "description": "Semantic version of the plugin.",
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string" },
    "kind": {
      "description": "What the plugin brings: one value or a list.",
      "oneOf": [
        { "$ref": "#/$defs/kind" },
        { "type": "array", "items": { "$ref": "#/$defs/kind" }, "minItems": 1, "uniqueItems": true }
      ]
    },
    "platform": {
      "description": "Range of kernel versions, for example \">=0.1 <1\".",
      "type": "string",
      "minLength": 1
    },
    "requires": {
      "description": "Required plugins with their accepted versions.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/dottedName" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "frontend": {
      "type": "object",
      "required": ["entry"],
      "properties": {
        "entry": { "$ref": "#/$defs/relativePath" },
        "isolation": { "enum": ["module", "iframe"], "default": "module" },
        "bridge": {
          "description": "What the frontend may do through the shell in an isolated iframe (MK-014).",
          "type": "object",
          "properties": {
            "publishes": {
              "type": "array",
              "items": { "$ref": "#/$defs/topic" },
              "uniqueItems": true
            },
            "subscribes": {
              "type": "array",
              "items": { "$ref": "#/$defs/topic" },
              "uniqueItems": true
            },
            "services": { "type": "array", "items": { "enum": ["api"] }, "uniqueItems": true }
          },
          "additionalProperties": false
        },
        "points": {
          "description": "Extension points the frontend offers to other plugins, which contribute to them (MK-020).",
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9-]*(\\.[a-z][a-zA-Z0-9-]*)+$" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "backend": {
      "description": "Java code of the plugin, loaded by the launcher at the next start.",
      "type": "object",
      "required": ["jar", "api"],
      "properties": {
        "jar": { "allOf": [{ "$ref": "#/$defs/relativePath" }, { "pattern": "\\.jar$" }] },
        "api": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" }
      },
      "additionalProperties": false
    },
    "database": {
      "type": "object",
      "required": ["schema"],
      "properties": {
        "schema": { "type": "string", "pattern": "^p_[a-z][a-z0-9_]{0,59}$" },
        "migrations": { "$ref": "#/$defs/relativePath", "default": "db" }
      },
      "additionalProperties": false
    },
    "contributes": {
      "description": "Contributions grouped by extension point.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/dottedName" },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id"],
          "properties": { "id": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "actions": {
      "description": "Typed actions that an assistant can use with the permissions of the person (MK-015).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "title", "risk", "call"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "risk": { "enum": ["read", "write", "execute"] },
          "input": {
            "description": "JSON Schema of the arguments, with type object.",
            "type": "object",
            "properties": { "type": { "const": "object" } }
          },
          "call": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
              "path": { "$ref": "#/$defs/relativePath" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "kind": { "enum": ["app", "extension", "service", "theme", "locale", "auth"] },
    "dottedName": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9-]*(\\.[a-z][a-zA-Z0-9-]*)+$" },
    "topic": {
      "description": "Dotted event topic, or a prefix ending with .*",
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9-]*(\\.[a-z][a-zA-Z0-9-]*)*\\.([a-z][a-zA-Z0-9-]*|\\*)$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "(^/|\\\\|:|(^|/)\\.\\.(/|$))" }
    }
  }
}
